# Terraform generated files
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log

# Terraform variable files may contain secrets
*.tfvars
*.tfvars.json
!terraform/terraform.tfvars.example

# Python generated files
__pycache__/
*.py[cod]
.venv/
venv/

# Environment variables and credentials
.env
.env.*
!.env.example

# IDE and operating system files
.vscode/
.idea/
.DS_Store
Thumbs.db